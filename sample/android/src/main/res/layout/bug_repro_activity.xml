<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SQLDelight Mapper NPE Bug Repro"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Click 'Insert Many Users'\n2. Wait for insert to complete\n3. Click 'Delete Random' multiple times\n4. Should crash with NPE"
        android:paddingBottom="16dp"/>

    <Button
        android:id="@+id/insertManyUsersButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Insert Many Users"/>

    <Button
        android:id="@+id/bugDeleteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Random"/>

    <ListView
        android:id="@+id/userListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
